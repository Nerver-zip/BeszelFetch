                "formula": "$gv(sum_rx) + gv(day_secs) * (if(tc(json, gv(tmp_day), \".items[73].stats.b[1]\") != \"\", mu(max, 0, tc(json, gv(tmp_day), \".items[73].stats.b[1]\")), mu(max, 0, tc(json, gv(tmp_day), \".items[73].stats.nr\") + 0) * 1048576))$"
              }
            },
            {
              "id": "bzhist_603",
