            },
            {
              "id": "bzhist_12",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_day), \".items[0].created\") != \"\", df(S, dp(tc(json, gv(tmp_day), \".items[0].created\"), auto)), 0)$"
              }
            },
            {
              "id": "bzhist_13",
              "type": "A_GLOBAL",
              "params": {
