                "global": "day_stamp"
              }
            },
            {
              "id": "bzhist_14",
              "type": "A_FORMULA",
              "params": {
                "formula": "$mu(max, 0, mu(min, gv(day_time), gv(day_stamp)) - mu(max, gv(day_time) - 86400, gv(day_stamp) - 1200))$"
              }
            },
            {
              "id": "bzhist_15",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "day_secs"
              }
            },
            {
              "id": "bzhist_16",
              "type": "A_FORMULA",
              "params": {
                "formula": "$gv(sum_tx) + gv(day_secs) * (if(tc(json, gv(tmp_day), \".items[0].stats.b[0]\") != \"\", mu(max, 0, tc(json, gv(tmp_day), \".items[0].stats.b[0]\")), mu(max, 0, tc(json, gv(tmp_day), \".items[0].stats.ns\") + 0) * 1048576))$"
              }
