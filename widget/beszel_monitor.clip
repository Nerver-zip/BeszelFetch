                "global": "sum_rx"
              }
            },
            {
              "id": "bzhist_604",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(day_ok) = 1 & tc(type, gv(sum_rx)) = NUMBER, mu(round, gv(sum_rx), 0), gv(net_24h_rx))$"
              }
            },
            {
              "id": "bzhist_605",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "net_24h_rx"
              }
            },
