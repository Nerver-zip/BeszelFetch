              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_day), \".items[71].created\") != \"\", df(S, dp(tc(json, gv(tmp_day), \".items[71].created\"), auto)), 0)$"
              }
            },
            {
              "id": "bzhist_581",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "day_stamp"
              }
            },
