              "id": "bzhist_606",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(day_ok) = 1 & tc(type, gv(sum_tx)) = NUMBER, mu(round, gv(sum_tx), 0), gv(net_24h_tx))$"
              }
            },
            {
              "id": "bzhist_607",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "net_24h_tx"
              }
            }
          ]
        },
        {
          "id": "bzcnt",
          "name": "fetch_containers",
          "t": [
            {
              "id": "bzcntcron",
              "type": "T_CRON",
              "params": {
                "cron_string": "*/5 * * * *"
              }
            }
          ],
          "a": [
            {
              "id": "bzcnt_0",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/container_stats/records?perPage=1&sort=-created&filter=system%3D%22\" + tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].id\") + \"%22%26%26type%3D%221m%22\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzcnt_1",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_cnt"
              }
            },
            {
              "id": "bzcnt_2",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_cnt), \".items[0].created\") != \"\" | (tc(json, gv(tmp_cnt), \".page\") > 0 & tc(json, gv(tmp_cnt), \".totalItems\") = 0), 1, 0)$"
              }
            },
            {
              "id": "bzcnt_3",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "cnt_ok"
              }
            },
            {
              "id": "bzcnt_4",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(cnt_ok) = 1, gv(tmp_cnt), gv(cnt_json))$"
              }
            },
            {
              "id": "bzcnt_5",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "cnt_json"
              }
            }
          ]
        },
        {
          "id": "bzinfo",
          "name": "fetch_info",
          "t": [],
          "a": [
            {
              "id": "bzinfo_0",
              "type": "A_FORMULA",
              "params": {
                "formula": "$tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].id\")$"
              }
            },
            {
              "id": "bzinfo_1",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_req"
              }
            },
            {
              "id": "bzinfo_2",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/system_details/records/\" + gv(info_req) + \"?fields=id,system,hostname,kernel,cores,threads,cpu,os,os_name,arch,memory\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzinfo_3",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_meta"
              }
            },
            {
              "id": "bzinfo_4",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/systems/records/\" + gv(info_req) + \"?fields=id,name,status,info\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzinfo_5",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_isys"
              }
            },
            {
              "id": "bzinfo_6",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/system_stats/records?perPage=1&fields=created,stats&sort=-created&filter=system%3D%22\" + gv(info_req) + \"%22%26%26type%3D%221m%22\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzinfo_7",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_istat"
              }
            },
            {
              "id": "bzinfo_8",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_isys), \".id\") = gv(info_req) & tc(json, gv(tmp_istat), \".items[0].stats.cpu\") != \"\" & gv(info_req) != \"\", 1, 0)$"
              }
            },
            {
              "id": "bzinfo_9",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_ok"
              }
            },
            {
              "id": "bzinfo_10",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(info_ok) = 1, gv(tmp_isys), gv(info_sys))$"
              }
            },
            {
              "id": "bzinfo_11",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_sys"
              }
            },
            {
              "id": "bzinfo_12",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(info_ok) = 1, gv(tmp_istat), gv(info_stats))$"
              }
            },
            {
              "id": "bzinfo_13",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_stats"
              }
            },
            {
              "id": "bzinfo_14",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_meta), \".id\") = gv(info_req) & gv(info_req) != \"\", 1, 0)$"
              }
            },
            {
              "id": "bzinfo_15",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "meta_ok"
              }
            },
            {
              "id": "bzinfo_16",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(info_ok) = 1, if(gv(meta_ok) = 1, gv(tmp_meta), if(gv(info_host) = gv(info_req), gv(info_meta), \"{}\")), gv(info_meta))$"
              }
            },
            {
              "id": "bzinfo_17",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_meta"
              }
            },
            {
              "id": "bzinfo_18",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(info_ok) = 1, gv(info_req), gv(info_host))$"
              }
            },
            {
              "id": "bzinfo_19",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_host"
              }
            },
            {
              "id": "bzinfo_20",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(info_ok) = 1, df(S), gv(info_at))$"
              }
            },
            {
              "id": "bzinfo_21",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_at"
              }
            },
            {
              "id": "bzinfo_22",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(info_ok) = 1, if(gv(meta_ok) = 1, \"Updated\", \"Metadata unavailable\"), \"Refresh failed · cache kept\")$"
              }
            },
            {
              "id": "bzinfo_23",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "info_error"
              }
            }
          ]
        }
      ]
    }
  ]
}
