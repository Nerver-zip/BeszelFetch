          "global_formula": "$if(tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.la[0]\") != \"\", tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.la[0]\"), tc(json, gv(latest), \".items[0].stats.la[0]\"))$"
