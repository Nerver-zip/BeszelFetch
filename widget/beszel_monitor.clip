    {
      "internal_type": "KomponentModule",
      "internal_title": "Beszel Monitor",
      "internal_description": "Homelab monitoring widget consuming Beszel API directly with Catppuccin Mocha aesthetic.",
      "globals_list": {
        "bz_url": {
          "index": 1,
          "type": "TEXT",
          "title": "Beszel Hub URL",
