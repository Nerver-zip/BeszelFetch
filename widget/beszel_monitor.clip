      "internal_flows": [
        {
          "id": "FvLj5OVJ",
          "name": "refresh_beszel",
          "t": [
            {
              "id": "bzonce",
              "type": "T_ONCE"
            }
          ],
          "a": [
            {
              "id": "bzsys_0",
              "type": "A_FORMULA",
              "params": {
                "formula": "$1$"
              }
            },
            {
              "id": "bzsys_1",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "stale"
              }
            },
            {
              "id": "bzsys_2",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzsys_3",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_sys"
              }
            },
            {
              "id": "bzsys_4",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_sys), \".items[0].id\") != \"\", 1, 0)$"
              }
            },
            {
              "id": "bzsys_5",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "sys_ok"
              }
            },
            {
              "id": "bzsys_6",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(sys_ok) = 1, gv(tmp_sys), gv(sys_json))$"
              }
            },
            {
              "id": "bzsys_7",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "sys_json"
              }
            },
            {
              "id": "bzsys_8",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(sys_ok) = 1, df(S), gv(last_ok))$"
              }
            },
            {
              "id": "bzsys_9",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "last_ok"
              }
            },
            {
              "id": "bzsys_10",
              "type": "A_FORMULA",
              "params": {
