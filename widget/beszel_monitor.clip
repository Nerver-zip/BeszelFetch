        "net_tx": {
          "index": 63,
          "type": "TEXT",
          "title": "net_tx",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(tc(json, gv(latest), \".items[0].stats.b[0]\") != \"\", mu(max, 0, tc(json, gv(latest), \".items[0].stats.b[0]\")), if(tc(json, gv(latest), \".items[0].stats.ns\") != \"\", mu(max, 0, tc(json, gv(latest), \".items[0].stats.ns\")) * 1048576, if(tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.bb[0]\") != \"\", mu(max, 0, tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.bb[0]\")), 0)))$"
        },
        "rate_tx": {
          "index": 64,
          "type": "TEXT",
          "title": "rate_tx",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(net_tx) >= 1048576, mu(round, gv(net_tx) / 1048576, 1) + \" MiB/s\", mu(round, gv(net_tx) / 1024, 1) + \" KiB/s\")$"
        },
        "net_rx": {
          "index": 65,
          "type": "TEXT",
          "title": "net_rx",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(tc(json, gv(latest), \".items[0].stats.b[1]\") != \"\", mu(max, 0, tc(json, gv(latest), \".items[0].stats.b[1]\")), if(tc(json, gv(latest), \".items[0].stats.nr\") != \"\", mu(max, 0, tc(json, gv(latest), \".items[0].stats.nr\")) * 1048576, if(tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.bb[1]\") != \"\", mu(max, 0, tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.bb[1]\")), 0)))$"
        },
        "rate_rx": {
          "index": 66,
          "type": "TEXT",
          "title": "rate_rx",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(net_rx) >= 1048576, mu(round, gv(net_rx) / 1048576, 1) + \" MiB/s\", mu(round, gv(net_rx) / 1024, 1) + \" KiB/s\")$"
        },
        "ram_fmt": {
          "index": 67,
          "type": "TEXT",
          "title": "ram_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(ramused) != \"\" & gv(ramtotal) != \"\", mu(round, gv(ramused), 1) + \" / \" + mu(round, gv(ramtotal), 1) + \" GiB\", \"N/A\")$"
        },
        "disk_fmt": {
          "index": 68,
          "type": "TEXT",
          "title": "disk_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(diskused) != \"\" & gv(disktotal) != \"\", mu(round, gv(diskused), 1) + \" / \" + mu(round, gv(disktotal), 1) + \" GiB\", \"N/A\")$"
        },
        "temp_fmt": {
          "index": 69,
          "type": "TEXT",
          "title": "temp_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(temp) != \"\", mu(round, gv(temp), 1) + \"°C\", \"N/A\")$"
        },
        "up_days": {
          "index": 70,
          "type": "TEXT",
          "title": "up_days",
          "value": "",
          "toggles": 10,
          "global_formula": "$mu(floor, (gv(uptime) + 0) / 86400)$"
        },
        "up_hours": {
          "index": 71,
          "type": "TEXT",
          "title": "up_hours",
          "value": "",
          "toggles": 10,
          "global_formula": "$mu(floor, (gv(uptime) + 0) / 3600) - gv(up_days) * 24$"
        },
        "up_fmt": {
          "index": 72,
          "type": "TEXT",
          "title": "up_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(uptime) != \"\", gv(up_days) + \"d \" + gv(up_hours) + \"h\", \"N/A\")$"
        },
        "load1_fmt": {
          "index": 73,
          "type": "TEXT",
          "title": "load1_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(load1) != \"\", mu(round, gv(load1), 2), \"N/A\")$"
        },
        "load5_fmt": {
          "index": 74,
          "type": "TEXT",
          "title": "load5_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(load5) != \"\", mu(round, gv(load5), 2), \"N/A\")$"
        },
        "load15_fmt": {
          "index": 75,
          "type": "TEXT",
          "title": "load15_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(load15) != \"\", mu(round, gv(load15), 2), \"N/A\")$"
        },
        "loads": {
          "index": 76,
          "type": "TEXT",
          "title": "loads",
          "value": "",
          "toggles": 10,
          "global_formula": "$gv(load1_fmt) + \" / \" + gv(load5_fmt) + \" / \" + gv(load15_fmt)$"
        },
        "buffer_fmt": {
          "index": 77,
          "type": "TEXT",
          "title": "buffer_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(buffer) != \"\", mu(round, gv(buffer), 2) + \" GiB\", \"N/A\")$"
        },
        "swap_fmt": {
          "index": 78,
          "type": "TEXT",
          "title": "swap_fmt",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(swap) != \"\", mu(round, gv(swapused) + 0, 2) + \" / \" + mu(round, gv(swap), 2) + \" GiB\", \"N/A\")$"
        },
        "partition": {
          "index": 79,
          "type": "TEXT",
          "title": "partition",
          "value": "",
          "toggles": 10,
          "global_formula": "$\"Partition: N/A\"$"
        },
        "load_period": {
          "index": 80,
          "type": "TEXT",
          "title": "load_period",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(load5) != \"\", \"5m\", if(gv(load15) != \"\", \"15m\", \"1m\"))$"
        },
        "load_best": {
          "index": 81,
          "type": "TEXT",
          "title": "load_best",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(load5) != \"\", gv(load5_fmt), if(gv(load15) != \"\", gv(load15_fmt), gv(load1_fmt)))$"
        },
        "day_rx": {
          "index": 82,
          "type": "TEXT",
          "title": "day_rx",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(net_24h_rx) >= 1073741824, \"≈ \" + mu(round, gv(net_24h_rx) / 1073741824, 1) + \" GiB\", if(gv(net_24h_rx) >= 1048576, \"≈ \" + mu(round, gv(net_24h_rx) / 1048576, 1) + \" MiB\", if(gv(net_24h_rx) > 0, \"≈ \" + mu(round, gv(net_24h_rx) / 1024, 1) + \" KiB\", \"0 KiB\")))$"
        },
        "day_tx": {
          "index": 83,
          "type": "TEXT",
          "title": "day_tx",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(net_24h_tx) >= 1073741824, \"≈ \" + mu(round, gv(net_24h_tx) / 1073741824, 1) + \" GiB\", if(gv(net_24h_tx) >= 1048576, \"≈ \" + mu(round, gv(net_24h_tx) / 1048576, 1) + \" MiB\", if(gv(net_24h_tx) > 0, \"≈ \" + mu(round, gv(net_24h_tx) / 1024, 1) + \" KiB\", \"0 KiB\")))$"
        },
        "info_ready": {
          "index": 84,
          "type": "TEXT",
          "title": "info_ready",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_host) = tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].id\") & gv(info_host) != \"\", 1, 0)$"
        },
        "fetch_host": {
          "index": 85,
          "type": "TEXT",
          "title": "fetch_host",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, if(tc(json, gv(info_meta), \".hostname\") != \"\", tc(json, gv(info_meta), \".hostname\"), if(tc(json, gv(info_sys), \".name\") != \"\", tc(json, gv(info_sys), \".name\"), \"N/A\")), \"N/A\")$"
        },
        "fetch_kernel": {
          "index": 86,
          "type": "TEXT",
          "title": "fetch_kernel",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, if(tc(json, gv(info_meta), \".kernel\") != \"\", tc(json, gv(info_meta), \".kernel\"), if(tc(json, gv(info_sys), \".info.k\") != \"\", tc(json, gv(info_sys), \".info.k\"), \"N/A\")), \"N/A\")$"
        },
        "fetch_cpu": {
          "index": 87,
          "type": "TEXT",
          "title": "fetch_cpu",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, if(tc(json, gv(info_meta), \".cpu\") != \"\", tc(json, gv(info_meta), \".cpu\"), if(tc(json, gv(info_sys), \".info.m\") != \"\", tc(json, gv(info_sys), \".info.m\"), \"N/A\")), \"N/A\")$"
        },
        "fetch_os_name": {
          "index": 88,
          "type": "TEXT",
          "title": "fetch_os_name",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, if(tc(json, gv(info_meta), \".os_name\") != \"\", tc(json, gv(info_meta), \".os_name\"), if(tc(json, gv(info_sys), \".info.o\") != \"\", tc(json, gv(info_sys), \".info.o\"), \"N/A\")), \"N/A\")$"
        },
        "fetch_os_id": {
          "index": 89,
          "type": "TEXT",
          "title": "fetch_os_id",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, if(tc(json, gv(info_meta), \".os\") != \"\", tc(json, gv(info_meta), \".os\"), if(tc(json, gv(info_sys), \".info.os\") != \"\", tc(json, gv(info_sys), \".info.os\"), \"N/A\")), \"N/A\")$"
        },
        "fetch_arch": {
          "index": 90,
          "type": "TEXT",
          "title": "fetch_arch",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, if(tc(json, gv(info_meta), \".arch\") != \"\", tc(json, gv(info_meta), \".arch\"), \"N/A\"), \"N/A\")$"
        },
        "fetch_os": {
          "index": 91,
          "type": "TEXT",
          "title": "fetch_os",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(fetch_os_name) != \"N/A\", gv(fetch_os_name), if(gv(fetch_os_id) = 0, \"Linux\", if(gv(fetch_os_id) = 1, \"macOS\", if(gv(fetch_os_id) = 2, \"Windows\", if(gv(fetch_os_id) = 3, \"FreeBSD\", \"Unknown OS\")))))$"
        },
        "fetch_os_lower": {
          "index": 92,
          "type": "TEXT",
          "title": "fetch_os_lower",
          "value": "",
          "toggles": 10,
          "global_formula": "$tc(low, gv(fetch_os))$"
        },
        "fetch_os_line": {
          "index": 93,
          "type": "TEXT",
          "title": "fetch_os_line",
          "value": "",
          "toggles": 10,
          "global_formula": "$gv(fetch_os) + if(gv(fetch_arch) != \"N/A\", \" · \" + gv(fetch_arch), \"\")$"
        },
        "fetch_u": {
          "index": 94,
          "type": "TEXT",
          "title": "fetch_u",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, tc(json, gv(info_sys), \".info.u\"), \"\")$"
        },
        "fetch_temp": {
          "index": 95,
          "type": "TEXT",
          "title": "fetch_temp",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, tc(json, gv(info_sys), \".info.dt\"), \"\")$"
        },
        "fetch_uptime": {
          "index": 96,
          "type": "TEXT",
          "title": "fetch_uptime",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(fetch_u) != \"\", mu(floor, gv(fetch_u) / 86400) + \"d \" + (mu(floor, gv(fetch_u) / 3600) - mu(floor, gv(fetch_u) / 86400) * 24) + \"h\", \"N/A\")$"
        },
        "fetch_temperature": {
          "index": 97,
          "type": "TEXT",
          "title": "fetch_temperature",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(fetch_temp) != \"\", mu(round, gv(fetch_temp), 1) + \"°C\", \"N/A\")$"
        },
        "fetch_memory": {
          "index": 98,
          "type": "TEXT",
          "title": "fetch_memory",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1 & tc(json, gv(info_stats), \".items[0].stats.mu\") != \"\" & tc(json, gv(info_stats), \".items[0].stats.m\") != \"\", mu(round, tc(json, gv(info_stats), \".items[0].stats.mu\"), 1) + \" / \" + mu(round, tc(json, gv(info_stats), \".items[0].stats.m\"), 1) + \" GiB\", \"N/A\")$"
        },
        "fetch_cores": {
          "index": 99,
          "type": "TEXT",
          "title": "fetch_cores",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1 & (if(tc(json, gv(info_meta), \".cores\") != \"\", tc(json, gv(info_meta), \".cores\"), if(tc(json, gv(info_sys), \".info.c\") != \"\", tc(json, gv(info_sys), \".info.c\"), 0))) > 0, (if(tc(json, gv(info_meta), \".cores\") != \"\", tc(json, gv(info_meta), \".cores\"), if(tc(json, gv(info_sys), \".info.c\") != \"\", tc(json, gv(info_sys), \".info.c\"), 0))) + \" cores / \" + (if(tc(json, gv(info_meta), \".threads\") != \"\", tc(json, gv(info_meta), \".threads\"), if(tc(json, gv(info_sys), \".info.t\") != \"\", tc(json, gv(info_sys), \".info.t\"), 0))) + \" threads\", \"N/A\")$"
        },
        "fetch_gpus": {
          "index": 100,
          "type": "TEXT",
          "title": "fetch_gpus",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(gv(info_ready) = 1, tc(json, gv(info_stats), \".items[0].stats.g.*.n\"), \"\")$"
        },
        "fetch_gpu": {
          "index": 101,
          "type": "TEXT",
          "title": "fetch_gpu",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(tc(json, gv(fetch_gpus), \"$[0]\") != \"\", tc(json, gv(fetch_gpus), \"$[0]\") + if(tc(json, gv(fetch_gpus), \"$[1]\") != \"\", \" + \" + tc(json, gv(fetch_gpus), \"$[1]\"), \"\"), \"Not reported\")$"
        },
        "fetch_logo": {
          "index": 102,
          "type": "TEXT",
          "title": "fetch_logo",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(tc(count, gv(fetch_os_lower), \"debian\") > 0, \"debian\", if(tc(count, gv(fetch_os_lower), \"ubuntu\") > 0, \"ubuntu\", if(tc(count, gv(fetch_os_lower), \"arch\") > 0, \"arch\", if(tc(count, gv(fetch_os_lower), \"fedora\") > 0, \"fedora\", if(tc(count, gv(fetch_os_lower), \"alpine\") > 0, \"alpine\", if(tc(count, gv(fetch_os_lower), \"nixos\") > 0, \"nixos\", if(tc(count, gv(fetch_os_lower), \"mint\") > 0, \"linuxmint\", if(tc(count, gv(fetch_os_lower), \"manjaro\") > 0, \"manjaro\", if(tc(count, gv(fetch_os_lower), \"rasp\") > 0, \"raspbian\", if(tc(count, gv(fetch_os_lower), \"red hat\") > 0, \"rhel\", if(tc(count, gv(fetch_os_lower), \"rocky\") > 0, \"rocky\", if(tc(count, gv(fetch_os_lower), \"centos\") > 0, \"centos\", if(tc(count, gv(fetch_os_lower), \"suse\") > 0, \"opensuse\", if(tc(count, gv(fetch_os_lower), \"gentoo\") > 0, \"gentoo\", if(tc(count, gv(fetch_os_lower), \"void\") > 0, \"void\", if(tc(count, gv(fetch_os_lower), \"freebsd\") > 0, \"freebsd\", if(tc(count, gv(fetch_os_lower), \"openbsd\") > 0, \"openbsd\", if(tc(count, gv(fetch_os_lower), \"netbsd\") > 0, \"netbsd\", if(tc(count, gv(fetch_os_lower), \"android\") > 0, \"android\", if(gv(fetch_os_id) = 0, \"linux\", if(gv(fetch_os_id) = 1, \"macos\", if(gv(fetch_os_id) = 2, \"windows_11\", if(gv(fetch_os_id) = 3, \"freebsd\", \"unknown\")))))))))))))))))))))))$"
        },
        "ascii_data": {
          "index": 103,
          "type": "TEXT",
          "title": "Fastfetch ASCII catalog",
          "value": "{\"linux\": {\"art\": \"    ___\\n   (.. \\\\\\n   (<> |\\n  //  \\\\ \\\\\\n ( |  | /|\\n_/\\\\ __)/_)\\n\\\\/-____\\\\/\", \"cols\": 10, \"color\": \"#FFFAB387\"}, \"debian\": {\"art\": \"  _____\\n /  __ \\\\\\n|  /    |\\n|  \\\\___-\\n-_\\n  --_\", \"cols\": 9, \"color\": \"#FFF38BA8\"}, \"ubuntu\": {\"art\": \"       ..;,; .,;,.\\n    .,lool: .ooooo,\\n   ;oo;:    .coool.\\n ....         ''' ,l;\\n:oooo,            'oo.\\nlooooc            :oo'\\n '::'             ,oo:\\n   ,.,       .... co,\\n    lo:;.   :oooo; .\\n     ':ooo; cooooc\\n        '''  ''''\", \"cols\": 22, \"color\": \"#FFFAB387\"}, \"arch\": {\"art\": \"      /\\\\\\n     /  \\\\\\n    /    \\\\\\n   /      \\\\\\n  /   ,,   \\\\\\n /   |  |   \\\\\\n/_-''    ''-_\\\\\", \"cols\": 14, \"color\": \"#FF89B4FA\"}, \"fedora\": {\"art\": \"        ,'''''.\\n       |   ,.  |\\n       |  |  '_'\\n  ,....|  |..\\n.'  ,_;|   ..'\\n|  |   |  |\\n|  ',_,'  |\\n '.     ,'\\n   '''''\", \"cols\": 16, \"color\": \"#FF89B4FA\"}, \"alpine\": {\"art\": \"   /\\\\ /\\\\\\n  // \\\\  \\\\\\n //   \\\\  \\\\\\n///    \\\\  \\\\\\n//      \\\\  \\\\\\n         \\\\\", \"cols\": 12, \"color\": \"#FF89B4FA\"}, \"nixos\": {\"art\": \"  \\u2597\\u2584   \\u2597\\u2584 \\u2584\\u2596\\n \\u2584\\u2584\\ud83e\\udf38\\u2588\\u2584\\u2584\\u2584\\ud83e\\udf38\\u2588\\u259b \\u2583\\n   \\u259f\\u259b    \\u259c\\u2583\\u259f\\ud83e\\udf15\\n\\ud83e\\udf0b\\ud83e\\udf0b\\ud83e\\udf2b\\u2588      \\u2588\\ud83e\\udf1b\\ud83e\\udf0b\\ud83e\\udf0b\\n \\ud83e\\udf37\\u259b\\ud83e\\udf83\\u2599    \\u259f\\u259b\\n \\ud83e\\udf83 \\u259f\\u2588\\ud83e\\udf34\\u2580\\u2580\\u2580\\u2588\\ud83e\\udf34\\u2580\\u2580\\n  \\u259d\\u2580 \\u2580\\u2598   \\u2580\\u2598\", \"cols\": 14, \"color\": \"#FFCBA6F7\"}, \"linuxmint\": {\"art\": \" ____________________\\n|                    \\\\\\n|_  |   ___________   |\\n  | |  /  __   __  \\\\  |\\n  | |  | |  | |  | |  |\\n  | |  | |  | |  | |  |\\n  | |  | |  | |  | |  |\\n  | |  \\\\_/  \\\\_/  | |  |\\n  | \\\\____________/_/  |\\n  \\\\___________________/\", \"cols\": 23, \"color\": \"#FFA6E3A1\"}, \"manjaro\": {\"art\": \"||||||||| ||||\\n||||||||| ||||\\n||||      ||||\\n|||| |||| ||||\\n|||| |||| ||||\\n|||| |||| ||||\\n|||| |||| ||||\", \"cols\": 14, \"color\": \"#FFA6E3A1\"}, \"raspbian\": {\"art\": \"   .~~.   .~~.\\n  '. \\\\ ' ' / .'\\n   .~ .~~~..~.\\n  : .~.'~'.~. :\\n ~ (   ) (   ) ~\\n( : '~'.~.'~' : )\\n ~ .~ (   ) ~. ~\\n  (  : '~' :  )\\n   '~ .~~~. ~'\\n       '~'\", \"cols\": 17, \"color\": \"#FFFAB387\"}, \"rhel\": {\"art\": \"      .M.:MMM\\n     MMMMMMMMMM.\\n    ,MMMMMMMMMMM\\n .MM MMMMMMMMMMM\\nMMMM   MMMMMMMMM\\nMMMMMM           MM\\n MMMMMMMMM     ,MMMM\\n   MMMMMMMMMMMMMMMM:\\n      `MMMMMMMMMMMM\", \"cols\": 20, \"color\": \"#FFF38BA8\"}, \"rocky\": {\"art\": \"    `-/+++++++++/-.`\\n `-+++++++++++++++++-`\\n.+++++++++++++++++++++.\\n-+++++++++++++++++++++++.\\n+++++++++++++++/-/+++++++\\n+++++++++++++/.   ./+++++\\n+++++++++++:.       ./+++\\n+++++++++:`   `:/:`   .:/\\n-++++++:`   .:+++++:`\\n .+++-`   ./+++++++++:`\\n  `-`   ./+++++++++++-\\n       -+++++++++:-.`\", \"cols\": 25, \"color\": \"#FF89B4FA\"}, \"centos\": {\"art\": \" ____^____\\n |\\\\  |  /|\\n | \\\\ | / |\\n<---- ---->\\n | / | \\\\ |\\n |/__|__\\\\|\\n     v\", \"cols\": 11, \"color\": \"#FF89B4FA\"}, \"opensuse\": {\"art\": \"  _______\\n__|   __ \\\\\\n     / .\\\\ \\\\\\n     \\\\__/ |\\n   _______|\\n   \\\\_______\\n__________/\", \"cols\": 11, \"color\": \"#FFA6E3A1\"}, \"gentoo\": {\"art\": \" _-----_\\n(       \\\\\\n\\\\    0   \\\\\\n \\\\        )\\n /      _/\\n(     _-\\n\\\\____-\", \"cols\": 11, \"color\": \"#FFCBA6F7\"}, \"void\": {\"art\": \"    ____\\n  'pfPfp.%\\n//  _._  \\\\\\\\\\nUU |===| UU\\n\\\\\\\\  ^~^  //\\n `0PpppP'\\n   `````\", \"cols\": 11, \"color\": \"#FFA6E3A1\"}, \"freebsd\": {\"art\": \"/\\\\,-'''''-,/\\\\\\n\\\\_)       (_/\\n|           |\\n|           |\\n ;         ;\\n  '-_____-'\", \"cols\": 13, \"color\": \"#FFF38BA8\"}, \"openbsd\": {\"art\": \"      _____\\n    \\\\-     -/\\n \\\\_/         \\\\\\n |        O O |\\n |_  <   )  3 )\\n / \\\\         /\\n    /-_____-\\\\\", \"cols\": 15, \"color\": \"#FFF38BA8\"}, \"netbsd\": {\"art\": \" \\\\\\\\`-______,----__\\n  \\\\\\\\        __,---`_\\n   \\\\\\\\       `.____\\n    \\\\\\\\-______,----`-\\n     \\\\\\\\\\n      \\\\\\\\\\n       \\\\\\\\\\n        \\\\\\\\\", \"cols\": 20, \"color\": \"#FF89B4FA\"}, \"macos\": {\"art\": \"        .:'\\n    __ :'__\\n .'`__`-'__``.\\n:__________.-'\\n:_________:\\n :_________`-;\\n  `.__.-.__.'\", \"cols\": 14, \"color\": \"#FF89B4FA\"}, \"windows_11\": {\"art\": \"lllllll  lllllll\\nlllllll  lllllll\\nlllllll  lllllll\\n\\nlllllll  lllllll\\nlllllll  lllllll\\nlllllll  lllllll\", \"cols\": 16, \"color\": \"#FF89B4FA\"}, \"android\": {\"art\": \"  ;,           ,;\\n   ';,.-----.,;'\\n  ,'           ',\\n /    O     O    \\\\\\n|                 |\\n'-----------------'\", \"cols\": 19, \"color\": \"#FFA6E3A1\"}, \"unknown\": {\"art\": \"  .--------.\\n  |  HOST  |\\n  |   ??   |\\n  |________|\\n     |__|\", \"cols\": 12, \"color\": \"#FF89B4FA\"}}"
        },
        "fetch_art": {
          "index": 104,
          "type": "TEXT",
          "title": "fetch_art",
          "value": "",
          "toggles": 10,
          "global_formula": "$tc(json, gv(ascii_data), \".\" + gv(fetch_logo) + \".art\")$"
        },
        "fetch_art_cols": {
          "index": 105,
          "type": "TEXT",
          "title": "fetch_art_cols",
          "value": "",
          "toggles": 10,
          "global_formula": "$tc(json, gv(ascii_data), \".\" + gv(fetch_logo) + \".cols\")$"
        },
        "fetch_art_color": {
          "index": 106,
          "type": "TEXT",
          "title": "fetch_art_color",
          "value": "",
          "toggles": 10,
          "global_formula": "$tc(json, gv(ascii_data), \".\" + gv(fetch_logo) + \".color\")$"
        },
