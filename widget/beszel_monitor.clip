                  "internal_title": "ViewOverview",
                  "config_stacking": "VERTICAL",
                  "config_margin": 6.0,
                  "internal_formulas": {
                    "config_visible": "if(gv(view) = 'overview', ALWAYS, REMOVE)"
                  },
                  "internal_toggles": {
