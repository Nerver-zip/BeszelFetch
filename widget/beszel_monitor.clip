          "title": "Container cache path",
          "toggles": 10,
          "value": ".stats",
          "global_formula": "$if(tc(json, gv(cnt_json), \".stats[0].n\") != \"\", \".stats\", if(tc(json, gv(cnt_json), \".items[0].stats[0].n\") != \"\", \".items[0].stats\", \".stats\"))$"
        },
        "cpage": {
          "index": 32,
          "type": "TEXT",
