        "host": {
          "index": 49,
          "type": "TEXT",
          "title": "host",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].name\") != \"\", tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].name\"), gv(server_name))$"
