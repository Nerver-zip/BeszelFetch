                    {
                      "internal_type": "StackLayerModule",
                      "internal_title": "MetricsRow",
                      "config_stacking": "HORIZONTAL_CENTER",
                      "config_margin": 10.0,
                      "viewgroup_items": [
                        {
                          "internal_type": "TextModule",
                          "internal_title": "NetIO",
                          "text_expression": "NET ▲ 0KB/s ▼ 0KB/s",
                          "text_size": 9.0,
                          "paint_color": "#FF74C7EC",
                          "internal_globals": {
                            "paint_color": "c_net"
                          },
                          "internal_formulas": {
                            "text_expression": "NET $if(wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb[0]') != '', '▲' + if(wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb[0]') < 1048576, mu(round, wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb[0]') / 1024) + 'K/s', mu(round, wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb[0]') / 1048576, 1) + 'M/s') + ' ' + '▼' + if(wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb[1]') < 1048576, mu(round, wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb[1]') / 1024) + 'K/s', mu(round, wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb[1]') / 1048576, 1) + 'M/s'), if(wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name'), json, '.items[' + gv(sys_idx) + '].info.bb') < 1048576, mu(round, wg(if(gv(sys_json)!=''&gv(sys_json)!='{}', gv(sys_json), gv(bz_url)+'/api/collections/systems/records?perPage=100&fields=id,name,st