        "uptime": {
          "index": 51,
          "type": "TEXT",
          "title": "uptime",
          "value": "",
          "toggles": 10,
          "global_formula": "$if(tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.u\") != \"\", tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].info.u\"), tc(json, gv(latest), \".items[0].stats.u\"))$"
        },
