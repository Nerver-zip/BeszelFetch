        {
          "id": "bzsys",
          "name": "fetch_systems",
          "t": [
            {
              "id": "bzsyscron",
              "type": "T_CRON",
              "params": {
                "cron_string": "*/5 * * * *"
              }
            }
          ],
          "a": [
            {
              "id": "bzsys_0",
              "type": "A_FORMULA",
              "params": {
                "formula": "$1$"
              }
            },
            {
              "id": "bzsys_1",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "stale"
              }
            },
            {
              "id": "bzsys_2",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/systems/records?perPage=100&fields=id,name,status,info&sort=name\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzsys_3",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_sys"
              }
            },
            {
              "id": "bzsys_4",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_sys), \".items[0].id\") != \"\", 1, 0)$"
              }
            },
            {
              "id": "bzsys_5",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "sys_ok"
              }
            },
            {
              "id": "bzsys_6",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(sys_ok) = 1, gv(tmp_sys), gv(sys_json))$"
              }
            },
            {
              "id": "bzsys_7",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "sys_json"
              }
            },
            {
              "id": "bzsys_8",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(sys_ok) = 1, df(S), gv(last_ok))$"
              }
            },
            {
              "id": "bzsys_9",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "last_ok"
              }
            },
            {
              "id": "bzsys_10",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(sys_ok) = 1, 0, 1)$"
              }
            },
            {
              "id": "bzsys_11",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "stale"
              }
            },
            {
              "id": "bzsys_12",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/system_stats/records?perPage=1&fields=created,stats&sort=-created&filter=system%3D%22\" + tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].id\") + \"%22%26%26type%3D%221m%22\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzsys_13",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_now"
              }
            },
            {
              "id": "bzsys_14",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(tc(json, gv(tmp_now), \".items[0].created\") != \"\" & tc(json, gv(tmp_now), \".items[0].stats.cpu\") != \"\", 1, 0)$"
              }
            },
            {
              "id": "bzsys_15",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "now_ok"
              }
            },
            {
              "id": "bzsys_16",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(now_ok) = 1, gv(tmp_now), gv(latest))$"
              }
            },
            {
              "id": "bzsys_17",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "latest"
              }
            }
          ]
        },
        {
          "id": "bzhist",
          "name": "fetch_history",
          "t": [
            {
              "id": "bzhistcron",
              "type": "T_CRON",
              "params": {
                "cron_string": "*/15 * * * *"
              }
            }
          ],
          "a": [
            {
              "id": "bzhist_0",
              "type": "A_WGET",
              "params": {
                "uri": "$gv(bz_url) + \"/api/collections/system_stats/records?perPage=500&fields=created,stats&sort=created&filter=system%3D%22\" + tc(json, gv(sys_json), \".items[\" + gv(sys_idx) + \"].id\") + \"%22%26%26type%3D%2220m%22%26%26created%3E%22\" + tc(url, df(\"yyyy-MM-dd HH:mm:ss\", df(S) - 86400 - df(Z))) + \"%22\"$",
                "headers": "$\"Authorization: \" + gv(bz_token)$"
              }
            },
            {
              "id": "bzhist_1",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "tmp_day"
              }
            },
            {
              "id": "bzhist_2",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if((tc(json, gv(tmp_day), \".items[0].created\") != \"\" & tc(json, gv(tmp_day), \".items[0].stats.cpu\") != \"\") | (tc(json, gv(tmp_day), \".page\") > 0 & tc(json, gv(tmp_day), \".totalItems\") = 0), 1, 0)$"
              }
            },
            {
              "id": "bzhist_3",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "day_ok"
              }
            },
            {
              "id": "bzhist_4",
              "type": "A_FORMULA",
              "params": {
                "formula": "$if(gv(day_ok) = 1, gv(tmp_day), gv(day_json))$"
              }
            },
            {
              "id": "bzhist_5",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "day_json"
              }
            },
            {
              "id": "bzhist_6",
              "type": "A_FORMULA",
              "params": {
                "formula": "$df(S)$"
              }
            },
            {
              "id": "bzhist_7",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "day_time"
              }
            },
            {
              "id": "bzhist_8",
              "type": "A_FORMULA",
              "params": {
                "formula": "$0$"
              }
            },
            {
              "id": "bzhist_9",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "sum_rx"
              }
            },
