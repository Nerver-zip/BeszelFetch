            },
            {
              "id": "bzhist_575",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "day_secs"
              }
            },
            {
              "id": "bzhist_576",
              "type": "A_FORMULA",
              "params": {
                "formula": "$gv(sum_tx) + gv(day_secs) * (if(tc(json, gv(tmp_day), \".items[70].stats.b[0]\") != \"\", mu(max, 0, tc(json, gv(tmp_day), \".items[70].stats.b[0]\")), mu(max, 0, tc(json, gv(tmp_day), \".items[70].stats.ns\") + 0) * 1048576))$"
              }
            },
            {
              "id": "bzhist_577",
              "type": "A_GLOBAL",
              "params": {
                "store_mode": "TEXT",
                "global": "sum_tx"
              }
            },
            {
              "id": "bzhist_578",
              "type": "A_FORMULA",
              "params": {
                "formula": "$gv(sum_rx) + gv(day_secs) * (if(tc(json, gv(tmp_day), \".items[70].stats.b[1]\") != \"\", mu(max, 0, tc(json, gv(tmp_day), \".items[70].stats.b[1]\")), mu(max, 0, tc(json, gv(tmp_day), \".items[70].stats.nr\") + 0) * 1048576))$"
              }
            },
